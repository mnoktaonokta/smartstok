// Smart Dental — SmartStok (canlı Neon DB ile hizalı)

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MUHASEBE
  DEPO
  SAHA
  OBSERVER
}

enum LocationType {
  MAIN_DEPOT
  CLINIC_DEPOT
  /** Fail Listesi — gizli sistem deposu */
  FAIL_HOLD
  /** Tedarikçi bekleme — gizli sistem deposu */
  SUPPLIER_PENDING
}

enum FailCycleStatus {
  OPEN
  CLOSED
}

enum FailGivenDisposition {
  FAIL_HOLD
  CONSIGNMENT_EXCESS
}

enum FailShipmentStatus {
  CREATED
}

enum UtsStatus {
  PENDING
  SUCCESS
  FAILED
}

enum InboundReceiptStatus {
  PENDING
  COMPLETED
  DISCREPANCY
}

enum InventoryCountStatus {
  DRAFT
  COMPLETED
}

enum ErpProvider {
  BIZIMHESAP
  ELOGO
  PARASUT
}

/** E-belge özel entegratör (QNB / e-Logo) — muhasebe ERP'den ayrı */
enum EDocumentProvider {
  QNB
  ELOGO
}

enum EDocumentType {
  EARCHIVE
  EINVOICE
}

enum InvoiceDocStatus {
  DRAFT
  /** e-İrsaliye kesildi, fatura bekliyor */
  DESPATCHED
  SENT
  PROCESSING
  COMPLETED
  FAILED
  /** e-Arşiv iptal edildi */
  CANCELLED
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  hashedPassword      String
  fullName            String
  /** Bir kullanıcıya birden fazla yetki (ADMIN, SAHA, DEPO, MUHASEBE, OBSERVER) */
  roles               Role[]   @default([DEPO])
  isActive            Boolean  @default(true)
  forcePasswordChange Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  executedTransfers  TransferLog[] @relation("ExecutedTransfers")
  requestedTransfers TransferLog[] @relation("RequestedTransfers")
  visits             Visit[]
  tasks              Task[]
  assignedCustomers  Customer[]    @relation("AssignedCustomers")
  inboundReceipts    InboundReceipt[]
  failIntakes        FailIntake[]           @relation("FailIntakeCreatedBy")
  failIntakesEdited  FailIntake[]           @relation("FailIntakeEditedBy")
  failShipments      FailShipment[]
  failSupplierReceipts FailSupplierReceipt[]
}

model Product {
  id            String   @id @default(cuid())
  referenceCode String   @unique
  brand         String
  /** Serbest metin (Excel / formdan birebir) */
  category      String
  name          String
  diameter      Float?
  length        Float?
  purchasePrice  Decimal  @db.Decimal(12, 2)
  salePrice      Decimal  @db.Decimal(12, 2)
  barcode        String?  @unique
  /** Katalog varsayılanı — lot bazlı değer mal kabulde StockItem’a yazılır */
  productionDate DateTime?
  /** Katalog varsayılanı SKT */
  expiryDate     DateTime?
  /** 0 = alarm kapalı; stok bu değere ve altına düşünce uyarı */
  minStockLevel  Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stockItems          StockItem[]
  inventoryCountItems InventoryCountItem[]
  failGivenItems      FailGivenItem[]
  failShipmentLines   FailShipmentLine[]
  failSupplierReceiptLines FailSupplierReceiptLine[]
  failSwapsExpected   FailSupplierSwap[] @relation("SwapExpected")
  failSwapsReceived   FailSupplierSwap[] @relation("SwapReceived")
}

model Customer {
  id             String   @id @default(cuid())
  vknTckn        String   @unique
  name           String
  taxOffice      String?
  address        String?
  phone          String?
  /** Bizim Hesap cari / müşteri kodu (abstract API path param) */
  bizimHesapId   String?
  /** ÜTS kurum numarası (VKN ile sorgulanır) */
  utsInstitutionNumber String?
  /** Kamu kurumu (üniversite vb.) — e-Fatura KAMUFATURASI */
  isPublicEntity Boolean  @default(false)
  /** Harcama birimi VKN (fakülte vb.) — BuyerCustomerParty */
  spendingUnitVkn String?
  /** Saha satış temsilcisi (portföy) */
  assignedUserId String?
  assignedUser   User?    @relation("AssignedCustomers", fields: [assignedUserId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  locations   Location[]
  invoices    Invoice[]
  visits      Visit[]
  tasks       Task[]
  failIntakes FailIntake[]

  @@index([assignedUserId])
}

model Location {
  id         String       @id @default(cuid())
  name       String
  type       LocationType
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id])
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  stockItems      StockItem[]
  transfersFrom   TransferLog[] @relation("FromLocation")
  transfersTo     TransferLog[] @relation("ToLocation")

  @@index([customerId])
}

model StockItem {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  lotNumber    String
  serialNumber String?
  /** Üretim tarihi (ÜTS URT) — GS1 AI(11) */
  productionDate DateTime?
  /** Son kullanma tarihi (SKT) */
  expiryDate   DateTime?
  locationId   String
  location     Location  @relation(fields: [locationId], references: [id])
  isAvailable  Boolean   @default(true)
  utsStatus    UtsStatus @default(PENDING)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  transfers      TransferLog[]
  invoiceItems   InvoiceItem[]
  failGivenItems FailGivenItem[]

  @@index([productId])
  @@index([locationId])
  @@index([lotNumber])
}

model TransferLog {
  id             String    @id @default(cuid())
  fromLocationId String
  fromLocation   Location  @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     Location  @relation("ToLocation", fields: [toLocationId], references: [id])
  stockItemId    String
  stockItem      StockItem @relation(fields: [stockItemId], references: [id])
  executedById   String
  executedBy     User      @relation("ExecutedTransfers", fields: [executedById], references: [id])
  requestedById  String?
  requestedBy    User?     @relation("RequestedTransfers", fields: [requestedById], references: [id])
  createdAt      DateTime  @default(now())

  @@index([stockItemId])
  @@index([fromLocationId])
  @@index([toLocationId])
}

model Invoice {
  id             String    @id @default(cuid())
  invoiceNo      String?   @unique
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  bizimHesapGuid String?
  bizimHesapUrl  String?

  documentType      EDocumentType?
  eDocumentProvider EDocumentProvider?
  docStatus         InvoiceDocStatus   @default(DRAFT)
  /** ETTN / UUID */
  uuid              String?
  belgeOid          String?
  /** Resmi fatura numarası (QNB) */
  faturaNo          String?
  pdfData           Bytes?
  externalViewUrl   String?
  lastError         String?            @db.Text
  note              String?
  /** Taslağın bağlı olduğu konsinye deposu */
  locationId        String?
  /** e-İrsaliye ETTN */
  despatchUuid      String?
  despatchBelgeOid  String?
  despatchedAt      DateTime?
  /** GİB e-İrsaliye belge no (örn. SSI2026000000001) */
  despatchNo        String?
  /** e-İrsaliye PDF (fatura pdfData’dan ayrı) */
  despatchPdfData   Bytes?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items InvoiceItem[]

  @@index([customerId])
  @@index([docStatus])
  @@index([belgeOid])
  @@index([locationId])
}

model InvoiceItem {
  id          String    @id @default(cuid())
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id])
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])
  salePrice   Decimal   @db.Decimal(12, 2)
  discount    Decimal   @default(0) @db.Decimal(12, 2)
}

/** Saha ziyaret notu */
model Visit {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  note       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([userId])
  @@index([createdAt])
}

/** Müşteri görevi / hatırlatıcı */
model Task {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  dueDate     DateTime
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@index([userId])
  @@index([dueDate])
  @@index([isCompleted])
}

/** Ana depo mal kabul kaydı (fatura / manuel) */
model InboundReceipt {
  id               String               @id @default(cuid())
  supplierName     String?
  documentNumber   String?
  status           InboundReceiptStatus @default(PENDING)
  /** Eksik/fazla ürün özeti — Admin incelemesi için */
  discrepancyNote  String?              @db.Text
  invoiceLinesJson String?              @db.Text
  scannedLinesJson String?              @db.Text
  createdById      String?
  createdBy        User?                @relation(fields: [createdById], references: [id])
  createdAt        DateTime             @default(now())
  completedAt      DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([createdById])
}

/** Merkez depo stok sayım fişi */
model InventoryCount {
  id        String                @id @default(cuid())
  status    InventoryCountStatus  @default(DRAFT)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  items InventoryCountItem[]

  @@index([status])
  @@index([createdAt])
}

model InventoryCountItem {
  id               String         @id @default(cuid())
  countId          String
  count            InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  /** Sayım başındaki sistem stoku (merkez depo) */
  expectedQuantity Int
  /** Fiziki sayılan miktar */
  countedQuantity  Int            @default(0)

  @@unique([countId, productId])
  @@index([countId])
  @@index([productId])
}

/** Tekil firma / entegrasyon ayarları (id = 1) */
model CompanySettings {
  id          Int         @id @default(1)
  companyName String?
  address     String?
  vkn         String?
  taxOffice   String?
  phone       String?

  aiApiKey  String?
  utsFirmNo String?
  utsToken  String?

  erpProvider ErpProvider @default(BIZIMHESAP)

  /** Bizim Hesap */
  bhFirmId String?
  bhToken  String?
  bhApiKey String?

  /** Paraşüt */
  parasutCompanyId    String?
  parasutClientId     String?
  parasutClientSecret String?
  parasutUsername     String?
  parasutPassword     String?

  /** e-Logo (muhasebe ERP stub) */
  logoFirmNo   String?
  logoApiKey   String?
  logoUsername String?
  logoPassword String?

  /** E-belge sağlayıcısı (QNB / e-Logo) */
  eDocumentProvider EDocumentProvider @default(QNB)
  qnbUsername       String?
  qnbPassword       String?
  qnbErpKodu        String?
  qnbVkn            String?
  /** TEST | LIVE */
  qnbEnvironment    String?

  /** e-Logo PostBoxService (e-belge) */
  elogoUsername    String?
  elogoPassword    String?
  /** TEST | LIVE */
  elogoEnvironment String?

  /** Firma logosu (fatura görseli için) */
  logoData     Bytes?
  logoMimeType String?

  /** Fatura açıklamasına eklenecek banka hesap metni */
  bankAccountInfo String? @db.Text

  /** SaaS lisans bitiş tarihi — geçtiyse dashboard kilitlenir */
  licenseEndDate DateTime?

  updatedAt DateTime @updatedAt
}

/** Tedarikçi fail gönderim döngüsü */
model FailCycle {
  id        String          @id @default(cuid())
  status    FailCycleStatus @default(OPEN)
  createdAt DateTime        @default(now())
  closedAt  DateTime?

  intakes   FailIntake[]
  shipments FailShipment[]

  @@index([status])
  @@index([createdAt])
}

/** Müşteriden fail alma kaydı (tarihli klasör) */
model FailIntake {
  id             String    @id @default(cuid())
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id])
  cycleId        String
  cycle          FailCycle @relation(fields: [cycleId], references: [id])
  createdById    String?
  createdBy      User?     @relation("FailIntakeCreatedBy", fields: [createdById], references: [id])
  failCount      Int
  /** Fail > verilen ise müşteriye kalan adet alacağı */
  creditQuantity Int       @default(0)
  notes          String?
  /** Son düzenleme bilgisi */
  editedAt       DateTime?
  editedById     String?
  editedBy       User?     @relation("FailIntakeEditedBy", fields: [editedById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  specs      FailIntakeSpec[]
  givenItems FailGivenItem[]

  @@index([customerId])
  @@index([cycleId])
  @@index([createdAt])
  @@index([editedById])
}

/** Opsiyonel fail cinsi (serbest giriş) */
model FailIntakeSpec {
  id        String     @id @default(cuid())
  intakeId  String
  intake    FailIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  diameter  Float?
  length    Float?
  lotNumber String?

  @@index([intakeId])
}

/** Fail karşılığında verilen stok birimi */
model FailGivenItem {
  id          String               @id @default(cuid())
  intakeId    String
  intake      FailIntake           @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  stockItemId String               @unique
  stockItem   StockItem            @relation(fields: [stockItemId], references: [id])
  productId   String
  product     Product              @relation(fields: [productId], references: [id])
  disposition FailGivenDisposition
  createdAt   DateTime             @default(now())

  @@index([intakeId])
  @@index([productId])
  @@index([disposition])
}

/** Tedarikçiye fail gönderim talebi */
model FailShipment {
  id          String             @id @default(cuid())
  cycleId     String
  cycle       FailCycle          @relation(fields: [cycleId], references: [id])
  status      FailShipmentStatus @default(CREATED)
  createdById String?
  createdBy   User?              @relation(fields: [createdById], references: [id])
  createdAt   DateTime           @default(now())

  lines    FailShipmentLine[]
  receipts FailSupplierReceipt[]

  @@index([cycleId])
  @@index([createdAt])
}

model FailShipmentLine {
  id            String       @id @default(cuid())
  shipmentId    String
  shipment      FailShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  quantity      Int
  referenceCode String
  productName   String

  @@index([shipmentId])
  @@index([productId])
}

/** Tedarikçiden fail ürün teslim alma */
model FailSupplierReceipt {
  id          String        @id @default(cuid())
  shipmentId  String?
  shipment    FailShipment? @relation(fields: [shipmentId], references: [id])
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id])
  note        String?
  createdAt   DateTime      @default(now())

  lines FailSupplierReceiptLine[]
  swaps FailSupplierSwap[]

  @@index([shipmentId])
  @@index([createdAt])
}

model FailSupplierReceiptLine {
  id        String              @id @default(cuid())
  receiptId String
  receipt   FailSupplierReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId String
  product   Product             @relation(fields: [productId], references: [id])
  quantity  Int
  lotNumber String?

  @@index([receiptId])
  @@index([productId])
}

model FailSupplierSwap {
  id                String              @id @default(cuid())
  receiptId         String
  receipt           FailSupplierReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  expectedProductId String
  expectedProduct   Product             @relation("SwapExpected", fields: [expectedProductId], references: [id])
  receivedProductId String
  receivedProduct   Product             @relation("SwapReceived", fields: [receivedProductId], references: [id])
  quantity          Int

  @@index([receiptId])
}
